# scorm-mcp ortam değişkenleri — bkz. CONTRACTS.md §8
PUBLIC_BASE_URL=https://mcp.edumints.com/scorm
ROOT_PATH=/scorm
DATA_DIR=/data
PORT=8000

# Maliyet guardrail'leri
PACKAGE_TTL_DAYS=7
MAX_PROJECT_MB=50
MAX_PROJECTS_PER_KEY=100
MAX_ASSET_MB=25

# Build / runtime
BUILD_WORKERS=8
BUILD_SYNC_TIMEOUT_SEC=4
SCORM_DEFAULT_VERSION=1.2
DB_PATH=/data/scorm.db
PREVIEW_TTL_MIN=60
LOG_LEVEL=INFO

# W9 P0 — per-principal rate limit (dakika başına istek; in-process token bucket)
RATE_LIMIT_PER_MIN=60

# 1.5 — /demo iframe politikası: Content-Security-Policy: frame-ancestors. Varsayılan yalnız
# kendi origin'i (clickjacking'e karşı güvenli); portal gibi bilinen bir domain'i açmak için
# değiştirin (birden çok origin boşlukla ayrılır, CSP söz dizimine uyar).
# Not: 'self'/'none' anahtar sözcüklerindeki tek tırnaklar değerin PARÇASIDIR; dotenv yükleyiciniz
# tırnakları soysa bile sunucu bare self/none'ı otomatik 'self'/'none'a normalize eder.
DEMO_FRAME_ANCESTORS='self'
