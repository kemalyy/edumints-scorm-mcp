{
  "name": "_tokens",
  "typography": {
    "font_heading": "'Outfit', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font_body": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font_mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "base_size_px": 16,
    "scale_ratio": 1.25,
    "weight_heading": 700,
    "weight_body": 400,
    "weight_strong": 600,
    "line_height_tight": 1.15,
    "line_height_normal": 1.6,
    "letter_spacing_heading": "-0.025em"
  },
  "color": {
    "primary": "#4f46e5",
    "primary_hover": "#4338ca",
    "primary_contrast": "#ffffff",
    "secondary": "#7c3aed",
    "accent": "#0d9488",
    "bg": "#fafafa",
    "surface": "#ffffff",
    "surface_alt": "#f4f4f5",
    "border": "#e4e4e7",
    "text": "#18181b",
    "text_muted": "#6c6c75",
    "text_on_dark": "#fafafa",
    "success": "#168139",
    "success_bg": "#dcfce7",
    "error": "#cb2323",
    "error_bg": "#fee2e2",
    "warning": "#975606",
    "info": "#0284c7",
    "focus_ring": "#4f46e5"
  },
  "spacing": {
    "base_px": 4,
    "scale": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "content_max_width": "880px",
    "gutter": "clamp(16px, 4vw, 48px)"
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "pill": "999px"
  },
  "elevation": {
    "e0": "none",
    "e1": "0 1px 2px rgba(15,23,42,.06), 0 1px 3px rgba(15,23,42,.10)",
    "e2": "0 4px 6px -1px rgba(15,23,42,.10), 0 2px 4px -2px rgba(15,23,42,.10)",
    "e3": "0 10px 15px -3px rgba(15,23,42,.10), 0 4px 6px -4px rgba(15,23,42,.10)",
    "e4": "0 20px 25px -5px rgba(15,23,42,.12), 0 8px 10px -6px rgba(15,23,42,.10)"
  },
  "motion": {
    "duration_fast": "120ms",
    "duration_base": "220ms",
    "duration_slow": "400ms",
    "easing_standard": "cubic-bezier(0.2, 0, 0, 1)",
    "easing_emphasized": "cubic-bezier(0.2, 0, 0, 1.2)",
    "slide_transition": "slide",
    "reduce_motion_respect": true
  },
  "logo_asset_id": null,
  "logo_alt": null,
  "custom_fonts": [],
  "background_pattern": "none",
  "custom_css": null
